# Which model backend to use: "anthropic" (real) or "mock" (3 fixed points, free).
# If unset, local development uses the mock and production refuses to count.
PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-haiku-5-5.
ANTHROPIC_MODEL=

# Rate limit + monthly budget counter (required in production).
# Use the REST URL and token from the Upstash console, not the redis:// string.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Soft monthly cap on model calls. Keep a hard spend limit in the Anthropic console too.
MONTHLY_BUDGET_CALLS=800
